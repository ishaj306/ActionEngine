# Copy to .env and adjust.

# ---------------------------------------------------------------------------
# API (services/api)
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the API. The browser enforces this,
# not the server, so it is a convenience against misconfiguration rather than a
# security control -- anything that is not a browser ignores it entirely.
ALLOWED_ORIGINS=http://localhost:3000

# Clerk's issuer, from Dashboard > API keys > "Frontend API URL". The API
# fetches the signing keys from <issuer>/.well-known/jwks.json and verifies
# every token against them.
#
# With this unset, every document route returns 503. That is on purpose: a
# service that quietly serves everyone when its auth configuration is missing
# is the failure nobody notices until it is in the news.
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Optional. Set only if you configured a custom JWT audience in Clerk; leave
# blank and the audience check is skipped rather than failing every token.
CLERK_AUDIENCE=

# Optional. Restricts sign-in to particular email domains, comma separated.
# Google-only sign-in itself is a Clerk dashboard setting (Configure > SSO
# connections: enable Google, disable everything else including email/password),
# not something the API can enforce.
ALLOWED_EMAIL_DOMAINS=

# Local development ONLY. Serves every request as this user id with no token
# checked at all, and logs a warning on every request that uses it. Never set
# this anywhere real -- it is the whole authentication system turned off.
# AUTH_DEV_USER=local-dev

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------

# Where the browser reaches the API. NEXT_PUBLIC_ is inlined into the client
# bundle at build time, so it must never hold anything secret.
NEXT_PUBLIC_API_URL=http://localhost:8000

# From Clerk Dashboard > API keys. The publishable key is public by design and
# ships in the bundle; the secret key is read server-side only and must not be
# given a NEXT_PUBLIC_ prefix, which would publish it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Optional: OCR
# ---------------------------------------------------------------------------
# No variable needed. The engine looks for the `tesseract` binary on PATH and
# reports honestly when it is absent. Install Tesseract to enable scans; without
# it, images are refused with a reason rather than read as empty documents.
